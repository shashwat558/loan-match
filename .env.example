# loan-match — copy to `.env` and fill values. Never commit `.env`.
# cp .env.example .env
#
# Mapping note: serverless.yml reads the *_RDS vars at deploy time and
# injects them into Lambda as DB_HOST / DB_USER / DB_PASSWORD / UPLOAD_BUCKET.
# docker-compose.yml reads the non-suffixed vars for the LOCAL stack only.

# ---------- AWS / Serverless deploy (serverless.yml) ----------
AWS_REGION=ap-south-1
DB_HOST_RDS=
DB_PORT=5432
DB_NAME=loan_engine
DB_USER_RDS=
DB_PASSWORD_RDS=
UPLOAD_BUCKET_RDS=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ---------- n8n docker (docker-compose.yml → n8n service) ----------
TIMEZONE=Asia/Kolkata
N8N_ENCRYPTION_KEY=
WEBHOOK_URL=
# N8N_WEBHOOK_SECRET reused from above (Lambda → B → C shared secret).

# ---------- Local Postgres (docker-compose.yml → app-postgres) ----------
DB_USER=
DB_PASSWORD=
# DB_NAME reused from above.

# ---------- Local-dev leftovers (Lambda ignores these; tests use them) ----------
DB_HOST=localhost
UPLOAD_BUCKET=

# ---------- Optional ----------
# SES sender verified by the stack (SesEmailIdentity). Must click the
# verification mail; in SES sandbox every RECIPIENT must verify too.
SES_SENDER_EMAIL=
# CREATE_RDS=true makes `serverless deploy` also create RDS Postgres
# (db.t4g.micro, 20 GB). Default 'false' = zero-cost deploy + manual RDS.
# Requires DB_USER_RDS / DB_PASSWORD_RDS / DB_NAME above.
CREATE_RDS=false
# ALLOWED_ORIGIN defaults to "*" in Lambdas; set to http://localhost:8000 to pin UI origin.
ALLOWED_ORIGIN=
# API_URL is a helper only — paste the deployed endpoint into API_URL at the top of ui/index.html.
API_URL=
